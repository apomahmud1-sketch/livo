# Copy this file to .env and fill in the real values.
# NEVER commit .env — it holds the App Certificate (a secret).
# App ID: Agora Console → your project (same App ID the Livo app
# already uses in app.json → extra → AGORA_APP_ID).
AGORA_APP_ID=
# App Certificate: Agora Console → your project → App Certificate
# → Primary Certificate. The user copies this from his own console.
AGORA_APP_CERTIFICATE=
# Port the server listens on (the host usually sets PORT itself).
PORT=3000
# How long each token stays valid, in seconds (3600 = 1 hour).
TOKEN_TTL_SECONDS=3600
