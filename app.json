{
  "android": {
    "adaptiveIcon": {
      "backgroundColor": "#7c3aed",
      "foregroundImage": "./assets/icon.png"
    },
    "package": "com.livo.app",
    "intentFilters": [
      {
        "action": "VIEW",
        "category": [
          "BROWSABLE",
          "DEFAULT"
        ],
        "data": [
          {
            "scheme": "livo"
          }
        ]
      }
    ],
    "permissions": [
      "CAMERA",
      "RECORD_AUDIO",
      "INTERNET",
      "READ_MEDIA_IMAGES",
      "READ_MEDIA_VIDEO"
    ],
    "versionCode": 1
  },
  "assetBundlePatterns": [
    "**/*"
  ],
  "displayName": "Livo",
  "extra": {
    "AGORA_APP_ID": "ac11cdc3f22b4f86bb2fceab3820b8d7",
    "eas": {
      "projectId": "f856b1d6-e464-47ff-a6a8-98322772f8dd"
    },
    "googleOAuth": {
      "androidClientId": "REPLACE_WITH_ANDROID_CLIENT_ID.apps.googleusercontent.com",
      "iosClientId": "REPLACE_WITH_IOS_CLIENT_ID.apps.googleusercontent.com",
      "webClientId": "REPLACE_WITH_WEB_CLIENT_ID.apps.googleusercontent.com"
    }
  },
  "icon": "./assets/icon.png",
  "ios": {
    "bundleIdentifier": "com.livo.app",
    "infoPlist": {
      "NSCameraUsageDescription": "Livo needs camera access for 1-to-1 video calls.",
      "NSMicrophoneUsageDescription": "Livo needs microphone access for 1-to-1 video calls.",
      "NSPhotoLibraryUsageDescription": "Livo needs photo library access so you can share photos and videos in Moments."
    },
    "supportsTablet": true
  },
  "name": "livo",
  "owner": "jack8435s-team",
  "orientation": "portrait",
  "plugins": [
    "expo-av",
    "expo-image-picker",
    "expo-updates",
    "expo-video"
  ],
  "scheme": "livo",
  "slug": "livo",
  "splash": {
    "backgroundColor": "#7c3aed",
    "image": "./assets/splash.png",
    "resizeMode": "contain"
  },
  "updates": {
    "checkAutomatically": "ON_LOAD",
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "url": "https://u.expo.dev/f856b1d6-e464-47ff-a6a8-98322772f8dd",
    "requestHeaders": {
      "expo-channel-name": "production"
    }
  },
  "userInterfaceStyle": "light",
  "version": "1.0.0",
  "web": {
    "favicon": "./assets/icon.png"
  }
}
